# ==============================================================================
# WeatherGPT Environment Configuration
# ==============================================================================
# Replace 'your_openweather_api_key_here' with your real OpenWeatherMap key.
# If left as placeholder or empty, WeatherGPT automatically uses Open-Meteo
# so you can test the application immediately without an API key!
# ==============================================================================

OPENWEATHER_API_KEY=your_openweather_api_key_here
PORT=8000
HOST=0.0.0.0

# Cloudflare Quick Tunnel URL (e.g. https://xxxx-xxxx.trycloudflare.com)
# When your Cloudflare Tunnel changes, paste the new URL below:
PUBLIC_URL=https://your-tunnel-name.trycloudflare.com
