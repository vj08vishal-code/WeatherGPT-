# ==============================================================================
# WeatherGPT Environment Configuration Template
# ==============================================================================
# Copy this file and rename it to ".env"
# Command: copy .env.example .env
#
# Replace the placeholder below with your real OpenWeatherMap API key.
# Get a free key at: https://openweathermap.org/api
# ==============================================================================

# Your OpenWeatherMap API Key (Free tier key works great)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Server host and port configuration
PORT=8000
HOST=0.0.0.0

# Cloudflare Quick Tunnel or Public URL (e.g. https://your-tunnel-id.trycloudflare.com)
PUBLIC_URL=https://your-tunnel-name.trycloudflare.com
